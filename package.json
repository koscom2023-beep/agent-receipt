{
  "name": "@promptia-labs/agent-receipt",
  "version": "0.8.1",
  "description": "AI work audit receipts — verifies and records what an AI coding agent actually changed in your local git tree. Provides git-based evidence for compliance review (not a compliance guarantee).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-receipt": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CONTRACT.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "guard": "tsx src/cli.ts"
  },
  "dependencies": {
    "minimatch": "^9.0.5",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
